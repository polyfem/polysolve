    },
    {
        "pointer": "/CPUHybrid/subdomain_selection_strategy",
        "default": "gmm",
        "type": "string",
        "options": [
            "knee",
            "gmm",
            "fd",
            "cost",
            "aposteriori"
        ],
        "doc": "Strategy used to threshold row norms into the problematic subspace: gmm (Gaussian mixture model), knee (max-distance-to-chord knee point), fd (largest finite-difference jump), cost (minimize estimated solve cost), or aposteriori (not yet implemented)."
    },
    {
        "pointer": "/CPUHybrid/contact_patch_schwarz",
        "default": false,
        "type": "bool",
        "doc": "Additionally give each contact patch (see Solver::contact_patches) its own overlapping subdomain, combined additively (Schwarz) with the rest of the problematic subspace."
    },
    {
        "pointer": "/CPUHybrid/contact_patch_remove_covered",
        "default": false,
        "type": "bool",
        "doc": "Only used when contact_patch_schwarz is enabled. Before factorizing, drop any contact patch that is fully contained in another patch, since it would only ever add redundant correction; logs the number of patches before and after."
    },
    {
        "pointer": "/CPUHybrid/ras_correction",
        "default": false,
        "type": "bool",
        "doc": "Restricted Additive Schwarz correction: use the same problematic dof set as AMGF/select_bad_dofs, but build one subdomain per dof (every dof with a nonzero entry in that dof's row) and let each subdomain correct only the single dof it was built around, instead of merging dofs into shared clusters. Mutually exclusive with contact_patch_schwarz."
    },
    {
        "pointer": "/CPUHybrid/use_strumpack",
        "default": false,
        "type": "bool",
        "doc": "Experimental: factorize every subdomain larger than 1000 dofs with STRUMPACK's sparse multifrontal LU instead of Pardiso/Accelerate (smaller subdomains keep using SimplicialLDLT). Requires polysolve to be built with POLYSOLVE_WITH_STRUMPACK."
    },
    {
        "pointer": "/CPUHybrid/strumpack_compression",
        "default": "none",
        "type": "string",
        "options": [
            "none",
            "blr",
            "hss"
        ],
        "doc": "Only used when use_strumpack is enabled. Low-rank compression of STRUMPACK's frontal matrices: none (exact LU), blr (block low-rank) or hss (hierarchically semi-separable). STRUMPACK only compresses fronts whose separator has at least 512 (blr) or 1000 (hss) dofs, so small subdomains are factorized exactly either way. A compressed factorization is not exactly symmetric, so PCG's convergence guarantees no longer strictly hold."
    },
    {
        "pointer": "/CPUHybrid/strumpack_compression_rel_tol",
        "default": 1e-4,
        "type": "float",
        "doc": "Only used when strumpack_compression is not none. Relative tolerance of the low-rank compression."
    },
    {
